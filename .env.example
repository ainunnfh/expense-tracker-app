# Koneksi database MySQL/MariaDB.
#
# JANGAN tempel baris di bawah apa adanya — isinya contoh, bukan nilai yang valid.
#
# Lokal (Laragon), biasanya persis seperti ini:
#   DATABASE_URL="mysql://root:@localhost:3306/money_tracker"
#
# Hosting: pakai nilai dari penyedia databasemu, jangan disusun manual.
#   Railway  -> set variabelnya sebagai referensi: ${{ MySQL.MYSQL_URL }}
#              (Railway mengisi host, port, user, password, dan nama db-nya)
#   Lainnya  -> salin connection string yang mereka berikan, apa adanya.
#
# Bentuk umumnya: mysql://<user>:<password>@<host>:<port>/<nama_database>
DATABASE_URL=
