// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  sessions     Session[]
  pockets      Pocket[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  setting      Setting?
}

/// Login session. `id` holds a SHA-256 of the cookie token, never the token itself.
model Session {
  id        String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum CategoryType {
  INCOME
  EXPENSE
}

model Pocket {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[] @relation("PocketTransaction")
  transfersOut Transaction[] @relation("TransferFromPocket")
  transfersIn  Transaction[] @relation("TransferToPocket")
}

model Category {
  id   Int          @id @default(autoincrement())
  name String
  type CategoryType

  transactions Transaction[]
  budgets      Budget[]

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name, type])
}

/// Per-account preferences.
model Setting {
  id Int @id @default(autoincrement())

  /// Day the monthly cycle starts on, e.g. 25 for a payday-to-payday month.
  /// Capped at 28 so every month can contain it.
  monthStartDay Int @default(1)

  updatedAt DateTime @updatedAt

  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Spending target for one category in one month ("2026-09").
model Budget {
  id     Int    @id @default(autoincrement())
  month  String @db.VarChar(7)
  amount Int

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, month])
  @@index([month])
}

model Transaction {
  id     Int             @id @default(autoincrement())
  type   TransactionType
  amount Int
  note   String?
  date   DateTime        @default(now())

  pocketId Int?
  pocket   Pocket? @relation("PocketTransaction", fields: [pocketId], references: [id])

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])

  fromPocketId Int?
  fromPocket   Pocket? @relation("TransferFromPocket", fields: [fromPocketId], references: [id])

  toPocketId Int?
  toPocket   Pocket? @relation("TransferToPocket", fields: [toPocketId], references: [id])

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}
